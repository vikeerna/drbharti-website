# Canonical URL consolidation — Dr. Bharti Surgery
# Forces: https:// + non-www + no /index.html
# All variants 301-redirect to https://drbhartisurgery.com/...

RewriteEngine On

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://drbhartisurgery.com/$1 [R=301,L]

# 2. Force non-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# 3. Redirect /index.html to /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://drbhartisurgery.com/ [R=301,L]

# Consolidate overlapping piles pages (SEO canonicalization)
Redirect 301 /piles-fissure-fistula-treatment-ranchi.html https://drbhartisurgery.com/piles-fistula-surgery-ranchi.html

# Security headers (OWASP baseline for static site)
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
